generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}


datasource db {
  provider = "sqlite"
}

model Aquarium {
  id        String   @id @default(uuid())
  name      String
  volume    Int
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id    String @id @default(uuid())
  name  String
  email String
}