generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// User

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      String     @default("USER") // "USER" | "ADMIN" (voir note enums plus bas)
  aquariums Aquarium[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Aquarium

model Aquarium {
  id        String   @id @default(uuid())
  name      String
  volume    Int
  dimension Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  measurements     WaterMeasurement[]
  targetRanges     TargetRange[]
  alerts           Alert[]
  species          AquariumSpecies[]
  maintenanceTasks MaintenanceTask[]

  @@index([ownerId])
}

// Water

model WaterMeasurement {
  id          Int      @id @default(autoincrement())
  temperature Float
  ph          Float
  no2         Float
  no3         Float
  nh4         Float
  gh          Float
  kh          Float
  measuredAt  DateTime @default(now())
  alerts Alert[]

  aquarium   Aquarium @relation(fields: [aquariumId], references: [id])
  aquariumId String

  @@index([aquariumId, measuredAt])
}

// Target and Alert

model TargetRange {
  id         String         @id @default(uuid())
  parameter  WaterParameter
  
  min        Float?
  max        Float?

  aquarium   Aquarium       @relation(fields: [aquariumId], references: [id], onDelete: Cascade)
  aquariumId String

  alerts     Alert[]

  @@unique([aquariumId, parameter])
}

enum AlertType {
  TOO_LOW
  TOO_HIGH
}

model Alert {
  id            String         @id @default(uuid())
  parameter     WaterParameter
  value         Float
  targetLimit   Float
  type          AlertType

  triggeredAt   DateTime       @default(now())
  resolved      Boolean        @default(false)
  resolvedAt    DateTime?

  aquarium      Aquarium       @relation(fields: [aquariumId], references: [id], onDelete: Cascade)
  aquariumId    String

  measurement   WaterMeasurement? @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  measurementId Int?

  targetRange   TargetRange?   @relation(fields: [targetRangeId], references: [id], onDelete: SetNull)
  targetRangeId String?

  @@index([aquariumId, resolved])
}

// Species

model Specie {
  id          String     @id @default(uuid())
  name        String
  type        String
  description String

  aquariumLinks AquariumSpecies[]
  categories    Category[]
}

model Category {
  id    String @id @default(uuid())
  type  String
  value String

  species Specie[]
  waterType WaterMeasurement
  @@unique([type, value])
}

model AquariumSpecies {
  id         String  @id @default(uuid())
  quantity   Int
  notes      String?

  aquarium   Aquarium @relation(fields: [aquariumId], references: [id])
  aquariumId String
  specie     Specie   @relation(fields: [specieId], references: [id])
  specieId   String

  @@unique([aquariumId, specieId])
}

// Maintenance

model MaintenanceTask {
  id            String    @id @default(uuid())
  title         String // "Changement d'eau", "Nettoyage du filtre"...
  frequencyDays Int
  dueAt         DateTime
  lastDoneAt    DateTime?
  isTemplate    Boolean   @default(false)
  createdAt     DateTime  @default(now())

  aquarium   Aquarium @relation(fields: [aquariumId], references: [id])
  aquariumId String

  @@index([aquariumId, dueAt])
}